# Environment and secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks

# Auth and registry config
.npmrc
.pypirc

# Editor files
*.swp
*.swo
*~
*.bak
*.orig

# OS files
.DS_Store
Thumbs.db

# Local Claude settings
.claude/settings.local.json

# Claude Code worktree scratch (created by `git worktree add` via the Plan agent)
.claude/worktrees/

# Root-level MCP config (may contain personal tokens/paths).
# Plugin-level .mcp.json under plugins/*/ is intentionally committed — those
# ship with the plugin and use ${ENV_VAR} substitutions, not raw secrets.
/.mcp.json

# Dependencies
node_modules/
__pycache__/
*.pyc
